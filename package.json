{
  "name": "dsh-plugin-session-fleet",
  "description": "Session Fleet: model-facing tools that let one DeepSeek Harness agent discover, read, create, and message other DSH sessions.",
  "version": "0.2.0",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sivan757/dsh-plugin-session-fleet.git"
  },
  "homepage": "https://github.com/Sivan757/dsh-plugin-session-fleet#readme",
  "bugs": {
    "url": "https://github.com/Sivan757/dsh-plugin-session-fleet/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "fleet",
    "multi-agent",
    "agent-teams"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build": "tsdown -c tsdown.config.ts && pnpm run build:types",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "check:host-support": "node scripts/check-host-support.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:refactor": "pnpm run check:host-support && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "pretest": "pnpm run check:refactor",
    "prepack": "pnpm run check:refactor && pnpm run test && pnpm run build",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "js-yaml": "^4.1.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
